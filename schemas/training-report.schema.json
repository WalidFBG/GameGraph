{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WalidFBG/GameGraph/schemas/training-report.schema.json",
  "title": "Training report: how one node's model was fitted, written by Python and read by the parity tests",
  "type": "object",
  "required": ["schemaVersion", "node", "createdUtc", "trainingGames", "examples", "negativeLogLikelihood", "optimiser"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "model.schema.json#/$defs/schemaVersion" },
    "node": { "$ref": "model.schema.json#/$defs/name" },
    "createdUtc": { "type": "string", "format": "date-time" },
    "trainingGames": { "type": "integer", "minimum": 1 },
    "examples": {
      "type": "object",
      "required": ["training", "validation"],
      "additionalProperties": false,
      "properties": {
        "training": { "type": "integer", "minimum": 1 },
        "validation": { "type": "integer", "minimum": 1 }
      }
    },
    "negativeLogLikelihood": {
      "type": "object",
      "required": ["training", "validation"],
      "additionalProperties": false,
      "properties": {
        "training": { "type": "number", "minimum": 0 },
        "validation": { "type": "number", "minimum": 0 }
      }
    },
    "optimiser": {
      "type": "object",
      "required": ["name", "iterations"],
      "additionalProperties": false,
      "properties": {
        "name": { "const": "lbfgs" },
        "iterations": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
