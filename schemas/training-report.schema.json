{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WalidFBG/GameGraph/schemas/training-report.schema.json",
  "title": "Training report: how one node's model was fitted, written by Python and read by the parity tests",
  "type": "object",
  "required": ["schemaVersion", "node", "createdUtc", "trainingGames", "examples", "chosen", "attempts", "failures"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "model.schema.json#/$defs/schemaVersion" },
    "node": { "$ref": "model.schema.json#/$defs/name" },
    "createdUtc": { "type": "string", "format": "date-time" },
    "trainingGames": { "type": "integer", "minimum": 1 },
    "examples": {
      "type": "object",
      "required": ["training", "validation"],
      "additionalProperties": false,
      "properties": {
        "training": { "type": "integer", "minimum": 1 },
        "validation": { "type": "integer", "minimum": 1 }
      }
    },
    "chosen": { "type": "integer", "minimum": 0 },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["route", "ridge", "negativeLogLikelihood", "iterations"],
        "additionalProperties": false,
        "properties": {
          "route": { "$ref": "#/$defs/route" },
          "ridge": { "type": "number", "minimum": 0 },
          "negativeLogLikelihood": { "$ref": "#/$defs/negativeLogLikelihood" },
          "iterations": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["route", "ridge", "reason"],
        "additionalProperties": false,
        "properties": {
          "route": { "$ref": "#/$defs/route" },
          "ridge": { "type": "number", "minimum": 0 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "route": { "enum": ["direct", "ridgePath"] },
    "negativeLogLikelihood": {
      "type": "object",
      "required": ["training", "validation"],
      "additionalProperties": false,
      "properties": {
        "training": { "type": "number", "minimum": 0 },
        "validation": { "type": "number", "minimum": 0 }
      }
    }
  }
}
