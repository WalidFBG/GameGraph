{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WalidFBG/GameGraph/schemas/model.schema.json",
  "title": "Model definitions shared by the documents",
  "$defs": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "declaration": {
      "type": "object",
      "required": ["distribution", "parameters"],
      "oneOf": [{ "$ref": "#/$defs/bernoulliDeclaration" }]
    },
    "fitted": {
      "type": "object",
      "required": ["distribution", "parameters"],
      "oneOf": [{ "$ref": "#/$defs/bernoulliFitted" }]
    },
    "bernoulliDeclaration": {
      "properties": {
        "distribution": { "const": "bernoulli" },
        "parameters": {
          "type": "object",
          "required": ["probability"],
          "additionalProperties": false,
          "properties": {
            "probability": { "$ref": "#/$defs/declaredPredicted" }
          }
        }
      }
    },
    "bernoulliFitted": {
      "properties": {
        "distribution": { "const": "bernoulli" },
        "parameters": {
          "type": "object",
          "required": ["probability"],
          "additionalProperties": false,
          "properties": {
            "probability": { "$ref": "#/$defs/fittedPredicted" }
          }
        }
      }
    },
    "link": { "enum": ["logit"] },
    "declaredPredicted": {
      "type": "object",
      "required": ["source", "link", "terms"],
      "additionalProperties": false,
      "properties": {
        "source": { "const": "predicted" },
        "link": { "$ref": "#/$defs/link" },
        "terms": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/declaredTerm" } }
      }
    },
    "fittedPredicted": {
      "type": "object",
      "required": ["source", "link", "intercept", "terms"],
      "additionalProperties": false,
      "properties": {
        "source": { "const": "predicted" },
        "link": { "$ref": "#/$defs/link" },
        "intercept": { "type": "number" },
        "terms": { "type": "array", "items": { "$ref": "#/$defs/fittedTerm" } }
      }
    },
    "declaredTerm": {
      "oneOf": [{ "$ref": "#/$defs/declaredLinear" }]
    },
    "fittedTerm": {
      "oneOf": [{ "$ref": "#/$defs/fittedLinear" }]
    },
    "declaredLinear": {
      "type": "object",
      "required": ["basis", "feature"],
      "additionalProperties": false,
      "properties": {
        "basis": { "const": "linear" },
        "feature": { "$ref": "#/$defs/name" }
      }
    },
    "fittedLinear": {
      "type": "object",
      "required": ["basis", "feature", "centre", "scale", "coefficients"],
      "additionalProperties": false,
      "properties": {
        "basis": { "const": "linear" },
        "feature": { "$ref": "#/$defs/name" },
        "centre": { "type": "number" },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "coefficients": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "number" } }
      }
    }
  }
}
